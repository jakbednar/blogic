@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="layout-container">
    <header class="top-navbar">
        <div class="brand" @onclick="NavigateHome">
            DUTY<span class="highlight">FREE</span>
        </div>
        <div class="navbar-actions">
            <span class="cart" @onclick="GoToCart">
                🛒 Košík (@Cart.Count)
            </span>
        </div>
    </header>

    <div class="page">
        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private List<Product> Cart = new();

    void GoToCart() => Navigation.NavigateTo("/kosik");
    void NavigateHome() => Navigation.NavigateTo("/");

    public record Product(string Name, int Price);
}