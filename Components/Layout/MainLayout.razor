@using blogic.Models
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject blogic.Services.CartService CartService

<div class="layout-container">
    <header class="top-navbar">
        <NavLink class="brand" href="">
            DUTY<span class="highlight">FREE</span>
        </NavLink>
        <div class="navbar-actions">
            <NavLink class="cart" href="cart">
                🛒 Košík (@CartService.GetCartCount())
            </NavLink>
            <NavLink class="login-button" href="login">
                🔐 Přihlášení 
            </NavLink>
        </div>
    </header>

    <div class="page">
        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}