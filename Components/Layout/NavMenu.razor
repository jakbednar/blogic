@inherits LayoutComponentBase
@inject blogic.Services.CartService CartService
@inject blogic.Services.UserSessionService Session
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<header class="top-navbar" style="display: flex; justify-content: space-between; align-items: center; padding: 15px; background-color: black; color: white;">
    <NavLink class="brand" href="/" style="font-size: 1.5rem; font-weight: bold; text-decoration: none; color: white;">
        DUTY<span style="color: orange;">FREE</span>
    </NavLink>

    <div class="navbar-actions" style="display: flex; gap: 10px;">
        <NavLink class="btn" style="background-color: orange; color: white; padding: 8px 16px; border-radius: 20px;" href="/cart">
            🛒 Košík (@CartService.GetCartCount())
        </NavLink>

        @if (Session.IsLoggedIn)
        {
            <div class="user-dropdown-hover">
                <div class="user-trigger">
                    👤 @Session.CurrentUser?.Name
                </div>
                <ul class="dropdown-menu">
                    <li><NavLink class="dropdown-item" href="/orders">🧾 Objednávky</NavLink></li>
                    <li><NavLink class="dropdown-item" href="/profile">🛠 Upravit profil</NavLink></li>
                    <li><NavLink class="dropdown-item" href="/credits">💳 Dobít kredity</NavLink></li>
                    <li><a href="#" class="dropdown-item" @onclick="Logout">🚪 Odhlásit se</a></li>
                </ul>
            </div>
        }
        else
        {
            <NavLink class="btn" style="background-color: orange; color: white; padding: 8px 16px; border-radius: 20px;" href="/login">
                🔐 Přihlášení
            </NavLink>
        }
    </div>
</header>

<div class="layout-container">
    <div class="page">
        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private bool _showDropdown = false;

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
        Session.OnChange += StateHasChanged;
    }

    private void ToggleDropdown()
    {
        _showDropdown = !_showDropdown;
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
        Session.OnChange -= StateHasChanged;
    }
}