@inherits LayoutComponentBase
@inject blogic.Services.CartService CartService
@inject blogic.Services.UserSessionService Session
@inject NavigationManager Navigation
@inject System.Data.IDbConnection Db
@using blogic.Models
@implements IDisposable
@rendermode InteractiveServer

@if (!_ready)
{
    <div style="padding: 1rem; color: gray;">Načítání přihlášení...</div>
}
else
{
    <header class="top-navbar" style="display: flex; justify-content: space-between; align-items: center; padding: 15px; background-color: black; color: white;">
        <NavLink class="brand" href="/" style="font-size: 1.5rem; font-weight: bold; text-decoration: none; color: white;">
            DUTY<span style="color: orange;">FREE</span>
        </NavLink>

        <div class="navbar-actions" style="display: flex; gap: 10px;">
            @if (Session.IsLoggedIn)
            {
                <NavLink class="btn" style="background-color: orange; color: white; padding: 8px 16px; border-radius: 20px;" href="/cart">
                    🛒 Košík (@CartService.GetCartCount())
                </NavLink>
                
                <div class="user-dropdown-hover">
                    <div class="user-trigger">👤 @Session.CurrentUser?.Name | @Session.CurrentUser?.Credit Kč</div>

                    <ul class="dropdown-menu">
                        <li class="has-submenu">
                            <a class="dropdown-item" href="#">⚙️ Admin</a>
                            <ul class="submenu-left">
                                <li><NavLink class="dropdown-item" href="/admin/users">Správa uživatelů</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/admin/orders">Správa objednávek</NavLink></li>
                                <li><NavLink class="dropdown-item" href="/admin/products">Správa produktů</NavLink></li>
                            </ul>
                        </li>
                        <li><NavLink class="dropdown-item" href="/orders">📦 Moje objednávky</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/profile">🙋 Profil</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/credits">💳 Kredity</NavLink></li>
                        <li><a class="dropdown-item" href="#" @onclick="Logout">🚪 Odhlásit se</a></li>
                    </ul>
                </div>


            }
            else
            {
                <NavLink class="btn" style="background-color: orange; color: white; padding: 8px 16px; border-radius: 20px;" href="/login">
                    🔐 Přihlášení
                </NavLink>
            }
        </div>
    </header>
}

@code {
    // Scoped code block

    private bool _ready = false;

    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
        CartService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_ready)
        {
            await Session.TryRestoreSession(Db);
            _ready = true;
            StateHasChanged();
        }
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
        CartService.OnChange -= StateHasChanged;
    }
}
