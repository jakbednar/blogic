@inherits LayoutComponentBase
@inject blogic.Services.CartService CartService
@inject blogic.Services.UserSessionService Session
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<header class="top-navbar" style="display: flex; justify-content: space-between; align-items: center; padding: 15px; background-color: black; color: white;">
    <NavLink class="brand" href="/" style="font-size: 1.5rem; font-weight: bold; text-decoration: none; color: white;">
        DUTY<span style="color: orange;">FREE</span>
    </NavLink>

    <div class="navbar-actions" style="display: flex; gap: 10px;">
        <NavLink class="btn" style="background-color: orange; color: white; padding: 8px 16px; border-radius: 20px;" href="/cart">
            🛒 Košík (@CartService.GetCartCount())
        </NavLink>

        @if (Session.IsLoggedIn)
        {
            <div class="user-dropdown" style="position: relative;">
                <button class="btn" @onclick="ToggleDropdown" style="background-color: orange; color: white; padding: 8px 16px; border-radius: 20px;">
                    👤 @Session.CurrentUser?.Name
                </button>

                @if (_showDropdown)
                {
                    <ul class="dropdown-menu" style="position: absolute; right: 0; background: white; color: black; list-style: none; padding: 0; margin: 0; border-radius: 6px; width: 180px; box-shadow: 0 2px 6px rgba(0,0,0,0.2); z-index: 1000;">
                        <li><NavLink class="dropdown-item" href="/orders" style="display: block; padding: 10px;">🧾 Objednávky</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/profile" style="display: block; padding: 10px;">🛠 Upravit profil</NavLink></li>
                        <li><NavLink class="dropdown-item" href="/credits" style="display: block; padding: 10px;">💳 Dobít kredity</NavLink></li>
                        <li><a href="#" class="dropdown-item" style="display: block; padding: 10px;" @onclick="Logout">🚪 Odhlásit se</a></li>
                    </ul>
                }
            </div>
        }
        else
        {
            <NavLink class="btn" style="background-color: orange; color: white; padding: 8px 16px; border-radius: 20px;" href="/login">
                🔐 Přihlášení
            </NavLink>
        }
    </div>
</header>

<div class="layout-container">
    <div class="page">
        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private bool _showDropdown = false;

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
        Session.OnChange += StateHasChanged;
    }

    private void ToggleDropdown()
    {
        _showDropdown = !_showDropdown;
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
        Session.OnChange -= StateHasChanged;
    }
}