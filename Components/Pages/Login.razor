@page "/login"
@rendermode InteractiveServer
@using Dapper
@using blogic.Data
@using blogic.Models
@using blogic.Services
@inject NavigationManager Navigation
@inject UserSessionService Session
@using System.ComponentModel.DataAnnotations

<h1>@(_showRegister ? "Registrace" : "Přihlášení")</h1>

@if (!_showRegister)
{
    <EditForm Model="@_loginModel" OnValidSubmit="@HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <InputText class="form-control" @bind-Value="_loginModel.Email" placeholder="Email" />
        <ValidationMessage For="@(() => _loginModel.Email)" />

        <InputText class="form-control" @bind-Value="_loginModel.Password" placeholder="Heslo" type="password" />
        <ValidationMessage For="@(() => _loginModel.Password)" />

        <button class="btn btn-primary mt-2" type="submit">Přihlásit se</button>
        <button class="btn btn-link" type="button" @onclick="() => _showRegister = true">Registrovat</button>
    </EditForm>
}
else
{
    <EditForm Model="@_registerModel" OnValidSubmit="@HandleRegister">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <InputText class="form-control" @bind-Value="_registerModel.Name" placeholder="Jméno"/>
        <ValidationMessage For="@(() => _registerModel.Name)"/>

        <InputText class="form-control" @bind-Value="_registerModel.Email" placeholder="Email"/>
        <ValidationMessage For="@(() => _registerModel.Email)"/>

        <InputText class="form-control" @bind-Value="_registerModel.Phone" placeholder="Telefon"/>
        <ValidationMessage For="@(() => _registerModel.Phone)"/>

        <InputText class="form-control" @bind-Value="_registerModel.Password" placeholder="Heslo" type="password"/>
        <ValidationMessage For="@(() => _registerModel.Password)"/>

        <InputText class="form-control" @bind-Value="_registerModel.ConfirmPassword" placeholder="Heslo znovu" type="password"/>
        <ValidationMessage For="@(() => _registerModel.ConfirmPassword)"/>

        <button class="btn btn-success mt-2" type="submit">Registrovat</button>
        <button class="btn btn-link" type="button" @onclick="() => _showRegister = false">Zpět</button>
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-warning mt-3">@_message</div>
}

@code {
    private bool _showRegister = false;
    private string _message = "";
    private LoginModel _loginModel = new();
    private RegisterModel _registerModel = new();

    private void HandleLogin()
    {
        using var db = Database.Get();

        var user = db.QueryFirstOrDefault<User>(
            "SELECT * FROM Users WHERE Email = @Email", new { _loginModel.Email });

        if (user == null)
        {
            _message = "Uživatel neexistuje.";
            return;
        }

        if (BCrypt.Net.BCrypt.Verify(_loginModel.Password, user.Password))
        {
            Session.Login(user);
            Navigation.NavigateTo("/");
        }
        else
        {
            _message = "Neplatné přihlašovací údaje.";
        }
    }

    private void HandleRegister()
    {
        Console.WriteLine("🟢 HandleRegister spuštěn");
        if (_registerModel.Password != _registerModel.ConfirmPassword)
        {
            _message = "Hesla se neshodují.";
            return;
        }

        using var db = Database.Get();

        var existing = db.QueryFirstOrDefault<User>(
            "SELECT * FROM Users WHERE Email = @Email", new { _registerModel.Email });

        if (existing != null)
        {
            _message = "Účet s tímto emailem již existuje.";
            return;
        }

        var passwordHash = BCrypt.Net.BCrypt.HashPassword(_registerModel.Password);

        db.Execute(@"
            INSERT INTO Users (Name, Email, Phone, Password, Role)
            VALUES (@Name, @Email, @Phone, @Password, 'User');
        ", new
        {
            _registerModel.Name,
            _registerModel.Email,
            _registerModel.Phone,
            Password = passwordHash
        });

        var user = db.QueryFirstOrDefault<User>(
            "SELECT * FROM Users WHERE Email = @Email", new { _registerModel.Email });

        if (user != null)
        {
            Session.Login(user);
            Navigation.NavigateTo("/");
        }
        else
        {
            _message = "Registrace se nezdařila.";
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email je povinný")]
        [EmailAddress(ErrorMessage = "Neplatný formát emailu")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Heslo je povinné")]
        public string Password { get; set; } = "";
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Jméno je povinné")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Email je povinný")]
        [EmailAddress(ErrorMessage = "Neplatný formát emailu")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Telefon je povinný")]
        [RegularExpression(@"^\d{9,15}$", ErrorMessage = "Zadejte platné číslo (9 až 15 číslic)")]
        public string Phone { get; set; } = "";

        [Required(ErrorMessage = "Heslo je povinné")]
        [MinLength(6, ErrorMessage = "Heslo musí mít alespoň 6 znaků")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Zopakujte heslo")]
        [Compare(nameof(Password), ErrorMessage = "Hesla se neshodují")]
        public string ConfirmPassword { get; set; } = "";
    }
}