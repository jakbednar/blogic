@page "/login"
@rendermode InteractiveServer
@using Dapper
@using blogic.Data
@using blogic.Models
@using blogic.Services
@inject NavigationManager Navigation
@inject UserSessionService Session
@using System.ComponentModel.DataAnnotations;

<h1>@(_showRegister ? "Registrace" : "Přihlášení")</h1>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info">@_message</div>
}

@if (!_showRegister)
{
    <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <InputText class="form-control" @bind-Value="_loginModel.Email" placeholder="Email" />
        <InputText class="form-control" @bind-Value="_loginModel.Password" placeholder="Heslo" type="password" />

        <button class="btn btn-primary" type="submit">Přihlásit se</button>
        <button class="btn btn-link" type="button" @onclick="() => _showRegister = true">Registrovat</button>
    </EditForm>
}
else
{
    <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <InputText class="form-control" @bind-Value="_registerModel.Name" placeholder="Jméno" />
        <InputText class="form-control" @bind-Value="_registerModel.Email" placeholder="Email" />
        <InputText class="form-control" @bind-Value="_registerModel.Password" placeholder="Heslo" type="password" />
        <InputText class="form-control" @bind-Value="_registerModel.ConfirmPassword" placeholder="Heslo znovu" type="password" />

        <button class="btn btn-success" type="submit">Registrovat</button>
        <button class="btn btn-link" type="button" @onclick="() => _showRegister = false">Zpět</button>
    </EditForm>
}

@code {
    private bool _showRegister = false;
    private string _message = "";
    private LoginModel _loginModel = new();
    private RegisterModel _registerModel = new();

    protected override void OnInitialized()
    {
        _message = Session.GetFlashMessage() ?? "";
        Session.ClearFlashMessage();
    }

    private void HandleLogin()
    {
        try
        {
            using var db = Database.Get();
            var user = db.QueryFirstOrDefault<User>(
                "SELECT * FROM Users WHERE Email = @Email", new { _loginModel.Email });

            if (user == null || !BCrypt.Net.BCrypt.Verify(_loginModel.Password, user.Password))
            {
                _message = "Neplatné přihlašovací údaje.";
                return;
            }

            Session.Login(user);
            Navigation.NavigateTo("/");
        }
        catch (Exception)
        {
            _message = "Chyba při přihlášení.";
        }
    }

    private void HandleRegister()
    {
        if (_registerModel.Password != _registerModel.ConfirmPassword)
        {
            _message = "Hesla se neshodují.";
            return;
        }

        using var db = Database.Get();
        var existing = db.QueryFirstOrDefault<User>(
            "SELECT * FROM Users WHERE Email = @Email", new { _registerModel.Email });

        if (existing != null)
        {
            _message = "Účet s tímto emailem již existuje.";
            return;
        }

        var passwordHash = BCrypt.Net.BCrypt.HashPassword(_registerModel.Password);

        db.Execute(@"
            INSERT INTO Users (Name, Email, Password, Role)
            VALUES (@Name, @Email, @PasswordHash, 'User');", new
        {
            _registerModel.Name,
            _registerModel.Email,
            PasswordHash = passwordHash
        });

        Session.SetFlashMessage("Registrace byla úspěšná! Nyní se můžete přihlásit.");
        Navigation.NavigateTo("/login", true);
    }

    public class LoginModel
    {
        [Required]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }

    public class RegisterModel
    {
        [Required]
        public string Name { get; set; } = "";

        [Required]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Hesla se neshodují.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
