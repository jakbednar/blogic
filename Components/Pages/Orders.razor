@page "/orders"
@using System.Data
@using Dapper
@rendermode InteractiveServer
@inject blogic.Services.UserSessionService Session
@inject IDbConnection Db

@if (orders == null)
{
    <p>Načítám...</p>
}
else if (!orders.Any())
{
    <p>Nemáš žádné objednávky.</p>
}
else
{
    <ul>
        @foreach (var o in orders)
        {
            <li>
                🛍️ <strong>@o.ProductName</strong> – @o.Quantity ks – @o.DateCreated
            </li>
        }
    </ul>
}

@code {
    private List<OrderView> orders;

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn) return;

        orders = Db.Query<OrderView>(
            @"SELECT o.OrderId, o.Quantity, o.DateCreated,
                     p.Name AS ProductName
              FROM Orders o
              JOIN Products p ON p.ProductId = o.ProductId
              WHERE o.UserId = @UserId
              ORDER BY o.DateCreated DESC",
            new { UserId = Session.CurrentUser!.UserId }
        ).ToList();
    }

    private class OrderView
    {
        public int OrderId { get; set; }
        public int Quantity { get; set; }
        public string ProductName { get; set; } = "";
        public string DateCreated { get; set; } = "";
    }
}
