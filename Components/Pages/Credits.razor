@page "/credits"
@rendermode InteractiveServer
@inject blogic.Services.UserSessionService Session
@using Dapper
@using blogic.Data
@using blogic.Models

<h2>💳 Dobití kreditu</h2>

@if (!Session.IsLoggedIn)
{
    <div class="alert alert-warning mt-3">Pro dobití kreditu se musíš přihlásit.</div>
}
else
{
    <h3>Aktuální částka: @Session.CurrentUser?.Credit Kč</h3>
    <p>Vyber částku, kterou chceš dobít:</p>

    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-outline-primary" @onclick="() => SelectAmount(100)">+100 Kč</button>
        <button class="btn btn-outline-primary" @onclick="() => SelectAmount(200)">+200 Kč</button>
        <button class="btn btn-outline-primary" @onclick="() => SelectAmount(500)">+500 Kč</button>
    </div>

    @if (_selectedAmount > 0)
    {
        <div class="mt-4">
            <p>💰 Vybral jsi: <strong>@_selectedAmount Kč</strong></p>
            <button class="btn btn-success" @onclick="ProcessPayment">➡️ Pokračovat na platbu</button>
        </div>
    }
}

@code {
    private int _selectedAmount = 0;

    private void SelectAmount(int amount)
    {
        _selectedAmount = amount;
    }

    private void ProcessPayment()
    {
        if (!Session.IsLoggedIn || Session.CurrentUser is null)
            return;

        var userId = Session.CurrentUser.UserId;

        using var db = Database.Get();

        db.Execute(
            "UPDATE Users SET Credit = Credit + @Amount WHERE UserID = @UserID",
            new { Amount = _selectedAmount, UserID = userId }
        );

        var refreshed = db.QueryFirstOrDefault<User>(
            "SELECT * FROM Users WHERE UserID = @UserID", new { UserID = userId });

        if (refreshed != null)
        {
            Session.Refresh(refreshed);
        }

        _selectedAmount = 0;
    }
}