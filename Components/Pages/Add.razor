@page "/add"
@rendermode InteractiveServer
@using blogic.Models
@using blogic.Services
@inject UserSessionService Session
@inject ProductService ProductService

<PageTitle>Správa produktů</PageTitle>

<header style="background-image: url('https://images.unsplash.com/photo-1559561854-266fba0e52c6'); background-size: cover; background-position: center; height: 200px; display: flex; align-items: center; justify-content: center; color: black; font-size: 2rem; font-weight: bold;">
    Správa produktů
</header>

<div style="padding: 30px; max-width: 900px; margin: auto;">
    @if (!Session.IsLoggedIn || !Session.IsAdmin)
    {
        <div class="alert alert-danger text-center mt-5">
            Přístup pouze pro administrátory.<br />
            <a href="/login">Přihlaste se</a> nebo se vraťte na <a href="/">domovskou stránku</a>.
        </div>
    }
    else
    {
        <h3>Přidat nový produkt</h3>
        <div class="form-row" style="display: flex; gap: 10px; margin-bottom: 20px;">
            <input placeholder="Název produktu" @bind="_newName" />
            <input placeholder="Cena (Kč)" type="number" @bind="_newPrice" />
            <input placeholder="Množství" type="number" @bind="_newQuantity" />
            <input placeholder="URL obrázku" @bind="_newImageUrl" />
            <button class="add-button" @onclick="AddProduct">Přidat</button>
        </div>

        <table class="cart-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Produkt</th>
                    <th>Cena</th>
                    <th>Množství</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _products)
                {
                    <tr>
                        <td>@item.ProductID</td>
                        <td class="product-info">
                            <img src="@item.ImageUrl" alt="@item.Name" class="cart-img" />
                            @if (_editingProductId == item.ProductID)
                            {
                                <input type="text" @bind="_editModel.Name" />
                            }
                            else
                            {
                                <span>@item.Name</span>
                            }
                        </td>
                        <td>
                            @if (_editingProductId == item.ProductID)
                            {
                                <input type="number" @bind="_editModel.Price" class="small-input" />
                            }
                            else
                            {
                                @($"{item.Price} Kč")
                            }
                        </td>
                        <td>
                            @if (_editingProductId == item.ProductID)
                            {
                                <input type="number" @bind="_editModel.Quantity" class="small-input" />
                            }
                            else
                            {
                                @($"{item.Quantity} ks")
                            }
                        </td>
                        <td>
                            @if (_editingProductId == item.ProductID)
                            {
                                <button class="action-button confirm-button" @onclick="() => ConfirmEdit(item.ProductID)">✅</button>
                            }
                            else
                            {
                                <button class="action-button edit-button" @onclick="() => EditProduct(item.ProductID)" title="Upravit">✏️</button>
                            }
                            <button class="action-button delete-button" @onclick="() => RemoveProduct(item.ProductID)" title="Odstranit">❌</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Product> _products = new();
    private string _newName = string.Empty;
    private int _newPrice;
    private int _newQuantity;
    private string _newImageUrl = string.Empty;

    private int? _editingProductId;
    private Product _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetAllProductsAsync();
    }

    private async Task AddProduct()
    {
        if (string.IsNullOrWhiteSpace(_newName) || _newPrice <= 0 || _newQuantity <= 0)
            return;

        var newProduct = new Product
        {
            ProductID = ProductService.NextId(),
            Name = _newName,
            Price = _newPrice,
            Quantity = _newQuantity,
            ImageUrl = string.IsNullOrWhiteSpace(_newImageUrl)
                ? "https://via.placeholder.com/50"
                : _newImageUrl,
            DateCreated = DateTime.UtcNow,
            CreatedBy = Session.CurrentUser?.UserId ?? 1,
            IsDeleted = false
        };

        ProductService.AddProduct(newProduct);
        _products.Add(newProduct);

        _newName = string.Empty;
        _newPrice = 0;
        _newQuantity = 0;
        _newImageUrl = string.Empty;
    }

    private void RemoveProduct(int productId)
    {
        ProductService.RemoveProduct(productId);
        var productToRemove = _products.FirstOrDefault(p => p.ProductID == productId);
        if (productToRemove != null)
        {
            _products.Remove(productToRemove);
        }
    }

    private void EditProduct(int productId)
    {
        var product = _products.FirstOrDefault(p => p.ProductID == productId);
        if (product != null)
        {
            _editingProductId = productId;

            _editModel = new Product
            {
                ProductID = product.ProductID,
                Name = product.Name,
                Price = product.Price,
                Quantity = product.Quantity,
                ImageUrl = product.ImageUrl
            };
        }
    }

    private void ConfirmEdit(int productId)
    {
        var product = _products.FirstOrDefault(p => p.ProductID == productId);
        if (product != null)
        {
            product.Name = _editModel.Name;
            product.Price = _editModel.Price;
            product.Quantity = _editModel.Quantity;
            product.ImageUrl = _editModel.ImageUrl;

            ProductService.UpdateProduct(product);
        }

        _editingProductId = null;
        _editModel = new Product();
    }
}