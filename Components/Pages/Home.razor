@page "/"
@using blogic.Models
@inject blogic.Services.ProductService ProductService
@inject blogic.Services.CartService CartService
@rendermode InteractiveServer

<PageTitle>Domů</PageTitle>

<div class="toast-container">
    @foreach (var message in toastMessages)
    {
        <div class="toast-alert">
            ✅ @message
        </div>
    }
</div>

<article class="main-content">
    <h1 class="headline">Co si dnes dáš?</h1>

    <div class="search-wrapper">
        <input class="search-input" placeholder="Hledat produkty..." />
        <button class="search-button">Hledat</button>
    </div>

    @if (products == null)
    {
        <p>Načítám...</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in products)
            {
                var inCart = CartService.GetCartItems()
                    .FirstOrDefault(ci => ci.Product.ProductID == product.ProductID)?.Quantity ?? 0;
                var stockLeft = product.Quantity - inCart;

                <div class="product-card">
                    <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                    <h3>@product.Name</h3>
                    @if (stockLeft > 0)
                    {
                        <p class="in-stock">Skladem @stockLeft ks</p>
                    }
                    else
                    {
                        <p style="color: red" class="out-stock">Skladem @stockLeft ks</p>
                    }
                    <p class="price">@product.Price Kč</p>
                    <button class="buy-button"
                            @onclick="() => AddToCart(product)"
                            disabled="@(stockLeft <= 0)">
                        Koupit
                    </button>
                </div>
            }
        </div>
    }
</article>

@code {
    private List<Product>? products;
    private List<string> toastMessages = new();

    protected override void OnInitialized()
    {
        products = ProductService.GetAllProducts();
    }

    private void AddToCart(Product product)
    {
        CartService.Add(product);

        var message = $"Přidáno do košíku: {product.Name}";
        toastMessages.Add(message);
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            toastMessages.Remove(message);
            await InvokeAsync(StateHasChanged);
        });
    }
}
