@page "/"
@using blogic.Models
@using blogic.Services
@inject ProductService ProductService
@inject CartService CartService
@inject NavigationManager Navigation
@inject UserSessionService Session
@rendermode InteractiveServer

<PageTitle>Domov</PageTitle>

<div class="toast-container">
    @foreach (var message in toastMessages)
    {
        <div class="toast-alert">
            ✅ @message
        </div>
    }
</div>

<article class="main-content">
    <h1 class="headline">Co si dnes dáš?</h1>

    <div class="search-wrapper">
        <input class="search-input" placeholder="Hledat produkty..." @bind="searchTerm" @bind:event="oninput" @onkeydown="HandleKeyDown"/>
        <button class="search-button" @onclick="Search">Hledat</button>
    </div>

    @if (products == null || reservedQuantities == null)
    {
        <p>Načítám...</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in products)
            {
                var reserved = reservedQuantities.TryGetValue(product.ProductID, out var value) ? value : 0;
                var stockLeft = product.Quantity - reserved;

                <div class="product-card">
                    <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                    <h3>@product.Name</h3>
                    @if (stockLeft > 0)
                    {
                        <p class="in-stock">Skladem @stockLeft ks</p>
                    }
                    else
                    {
                        <p style="color: red" class="out-stock">Není skladem</p>
                    }
                    <p class="price">@product.Price Kč</p>
                    <button class="buy-button"
                            @onclick="() => AddToCart(product.ProductID)"
                            disabled="@(stockLeft <= 0)">
                        Koupit
                    </button>
                </div>
            }
        </div>
    }
</article>

@code {
    private List<Product> allProducts = new();
    private List<Product>? products;
    private Dictionary<int, int> reservedQuantities = new();
    private List<string> toastMessages = new();
    private string searchTerm = string.Empty;

    protected override void OnInitialized()
    {
        allProducts = ProductService.GetAllProducts();
        products = new List<Product>(allProducts);
        reservedQuantities = ProductService.GetReservedQuantities();
    }

    private void AddToCart(int productId)
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        CartService.AddToCart(productId);

        var product = allProducts.FirstOrDefault(p => p.ProductID == productId);
        if (product != null)
        {
            var message = $"Přidáno do košíku: {product.Name}";
            toastMessages.Add(message);
            StateHasChanged();

            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                toastMessages.Remove(message);
                await InvokeAsync(StateHasChanged);
            });

            // aktualizuj rezervace
            reservedQuantities = ProductService.GetReservedQuantities();
        }
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            products = new List<Product>(allProducts);
        }
        else
        {
            products = allProducts
                .Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Search();
        }
    }
}
