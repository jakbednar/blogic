@page "/admin/products"
@rendermode InteractiveServer
@using blogic.Models
@using blogic.Services
@using Microsoft.AspNetCore.Components.Forms
@inject UserSessionService Session
@inject ProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Správa produktů</PageTitle>

<header class="page-header">
    Správa produktů
</header>

<div class="page-content">
    @if (!Session.IsAdmin)
    {
        <h2>Stránka nenalezena.</h2>
    }
    else
    {
        <div class="add-product-box">
            <h3>Přidat nový produkt</h3>

            <div class="form-row">
                <div class="form-group">
                    <label for="name">Název produktu</label>
                    <input id="name" class="form-control" @bind="_newName" placeholder="Název produktu" />
                </div>
                <div class="form-group">
                    <label for="price">Cena (Kč)</label>
                    <input id="price" class="form-control" type="number" min="1" @bind="_newPrice" />
                </div>
                <div class="form-group">
                    <label for="quantity">Množství</label>
                    <input id="quantity" class="form-control" type="number" min="1" @bind="_newQuantity" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group image-group">
                    <label>Obrázek</label>
                    <div class="image-input-toggle">
                        <button type="button"
                                class="tab-button @(useFileUpload ? "" : "active")"
                                @onclick="() => useFileUpload = false">
                            URL
                        </button>
                        <button type="button"
                                class="tab-button @(useFileUpload ? "active" : "")"
                                @onclick="() => useFileUpload = true">
                            Soubor
                        </button>
                    </div>
                    @if (!useFileUpload)
                    {
                        <input class="form-control" placeholder="URL obrázku" @bind="_newImageUrl" @oninput="PreviewImage" />
                    }
                    else
                    {
                        <div class="drop-zone">
                            <InputFile OnChange="HandleFileUpload" />
                        </div>
                    }
                </div>
                <div class="preview-image">
                    @if (!string.IsNullOrWhiteSpace(_newImageUrl))
                    {
                        <img src="@_newImageUrl" alt="Náhled" />
                    }
                    else
                    {
                        <span>🖼️ Náhled se zobrazí zde</span>
                    }
                </div>
            </div>

            <div class="form-actions">
                <button class="add-button" @onclick="AddProduct">➕ Přidat produkt</button>
            </div>
        </div>

        <table class="products-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Produkt</th>
                    <th>Cena</th>
                    <th>Množství</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _products)
                {
                    <tr>
                        <td>@item.ProductID</td>
                        <td class="product-info">
                            <img src="@item.ImageUrl" alt="@item.Name" class="product-img" />
                            @if (_editingProductId == item.ProductID)
                            {
                                <input type="text" class="form-control" @bind="_editModel.Name" />
                            }
                            else
                            {
                                <span>@item.Name</span>
                            }
                        </td>
                        <td>
                            @if (_editingProductId == item.ProductID)
                            {
                                <input type="number" class="small-input" @bind="_editModel.Price" />
                            }
                            else
                            {
                                @($"{item.Price} Kč")
                            }
                        </td>
                        <td>
                            @if (_editingProductId == item.ProductID)
                            {
                                <input type="number" class="small-input" @bind="_editModel.Quantity" />
                            }
                            else
                            {
                                @($"{item.Quantity} ks")
                            }
                        </td>
                        <td>
                            @if (_editingProductId == item.ProductID)
                            {
                                <button class="action-button confirm-button"
                                        @onclick="() => ConfirmEdit(item.ProductID)"
                                        title="Potvrdit">
                                    ✅
                                </button>
                            }
                            else
                            {
                                <button class="action-button edit-button"
                                        @onclick="() => EditProduct(item.ProductID)"
                                        title="Upravit">
                                    ✏️
                                </button>
                            }
                            <button class="action-button delete-button"
                                    @onclick="() => RemoveProduct(item.ProductID)"
                                    title="Odstranit">
                                ❌
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Product> _products = new();
    private string _newName = string.Empty;
    private int _newPrice;
    private int _newQuantity;
    private string _newImageUrl = string.Empty;
    private bool useFileUpload = false;

    private int? _editingProductId;
    private Product _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetAllProductsAsync();
    }

    private async Task AddProduct()
    {
        if (string.IsNullOrWhiteSpace(_newName) || _newPrice <= 0 || _newQuantity <= 0)
            return;

        var newProduct = new Product
        {
            ProductID   = ProductService.NextId(),
            Name        = _newName,
            Price       = _newPrice,
            Quantity    = _newQuantity,
            ImageUrl    = string.IsNullOrWhiteSpace(_newImageUrl)
                ? "https://via.placeholder.com/80"
                : _newImageUrl,
            DateCreated = DateTime.UtcNow,
            CreatedBy   = Session.CurrentUser?.UserId ?? 1,
            IsDeleted   = false
        };

        ProductService.AddProduct(newProduct);
        _products.Add(newProduct);

        _newName = string.Empty;
        _newPrice = 0;
        _newQuantity = 0;
        _newImageUrl = string.Empty;
    }


    private void RemoveProduct(int productId)
    {
        ProductService.RemoveProduct(productId);
        var toRemove = _products.FirstOrDefault(p => p.ProductID == productId);
        if (toRemove != null)
            _products.Remove(toRemove);
    }

    private void EditProduct(int productId)
    {
        var product = _products.First(p => p.ProductID == productId);
        _editingProductId = productId;
        _editModel = new Product
        {
            ProductID = product.ProductID,
            Name      = product.Name,
            Price     = product.Price,
            Quantity  = product.Quantity,
            ImageUrl  = product.ImageUrl
        };
    }

    private void ConfirmEdit(int productId)
    {
        var product = _products.First(p => p.ProductID == productId);
        product.Name     = _editModel.Name;
        product.Price    = _editModel.Price;
        product.Quantity = _editModel.Quantity;
        product.ImageUrl = _editModel.ImageUrl;
        ProductService.UpdateProduct(product);

        _editingProductId = null;
        _editModel = new Product();
    }

    private void PreviewImage(ChangeEventArgs e)
    {
        _newImageUrl = e.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(10_000_000);
            var buffer = new byte[file.Size];
            await stream.ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            _newImageUrl = $"data:{file.ContentType};base64,{base64}";
        }
    }
}
