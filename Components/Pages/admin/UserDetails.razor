@page "/admin/users/{UserId:int}"
@inject UserService UserService
@inject NavigationManager Navigation
@inject CartService CartService
@inject OrderService OrderService
@using blogic.Models
@using blogic.Services

<PageTitle>Detail uživatele</PageTitle>

@if (user == null)
{
    <p class="loading">Načítám data uživatele...</p>
}
else
{
    <div class="user-card">
        <img src="@user.ImageUrl" alt="Profilovka" class="user-image" />

        <div class="user-info">
            <h2>@user.Name</h2>
            <p><strong>Email:</strong> @user.Email</p>
            <p><strong>Role:</strong> @user.Role</p>
            <p><strong>Kredit:</strong> @user.Credit Kč</p>

            <button @onclick="GoBack" class="back-button">⬅️ Zpět na seznam</button>
        </div>
    </div>

    <section class="user-orders">
        <h3>Objednávky uživatele</h3>
        @if (orders != null && orders.Any())
        {
            @foreach (var order in orders)
            {
                <div class="order-container">
                    <div class="order-header">
                        🧾 Objednávka #@order.OrderId 
                        <span class="order-date">(@order.DateCreated)</span>
                    </div>

                    <div class="order-products">
                        @foreach (var item in order.Items)
                        {
                            <div class="product-item">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="product-image" />
                                <span class="product-name">@item.ProductName</span>
                                <span class="product-quantity">@item.Quantity ks</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <p>Žádné objednávky.</p>
        }
    </section>

    <section class="user-cart">
        <h3>Aktuální košík</h3>
        @if (cartItems != null && cartItems.Any())
        {
            <div class="cart-products">
                @foreach (var item in cartItems)
                {
                    <div class="product-item">
                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="product-image" />
                        <span class="product-name">@item.Product.Name</span>
                        <span class="product-quantity">@item.Quantity ks</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p>Košík je prázdný.</p>
        }
    </section>
}

@code {
    [Parameter]
    public int UserId { get; set; }

    private User? user;
    private List<OrderGroupView>? orders;
    private List<CartItem>? cartItems;

    protected override async Task OnParametersSetAsync()
    {
        user = await UserService.GetUserById(UserId);
        orders = await OrderService.GetOrdersByUserId(UserId);
        cartItems = CartService.GetCartByUserId(UserId);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/users");
    }
}
