@page "/profile"
@rendermode InteractiveServer
@inject blogic.Services.UserSessionService Session
@using Dapper
@using blogic.Data
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

<h2>🛠 Můj profil</h2>

@if (!Session.IsLoggedIn)
{
    <AuthAlert />
}
else
{
    <EditForm Model="@_model" OnValidSubmit="SaveChanges" class="profile-container">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="profile-image-section">
            <label class="profile-pic-wrapper">
                <img src="@_model.ImageUrl" alt="Profilová fotka" class="profile-pic" />
                <InputFile OnChange="HandleFileUpload" class="hidden-file" />
            </label>
        </div>

        <div class="profile-fields">
            <div class="field-group">
                <label>Jméno</label>
                <InputText class="form-control" @bind-Value="_model.Name" />
            </div>

            <div class="field-group">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" />
            </div>

            <div class="field-group">
                <label>Nové heslo <span class="text-muted">(nepovinné)</span></label>
                <InputText type="password" class="form-control" @bind-Value="_model.NewPassword" />
            </div>

            <button class="btn-save">💾 Uložit změny</button>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="mt-3 alert alert-info">@_message</div>
    }
}

@code {
    private ProfileModel _model = new();
    private string _message = "";

    protected override void OnInitialized()
    {
        if (Session.CurrentUser != null)
        {
            _model = new ProfileModel
            {
                Name = Session.CurrentUser.Name,
                Email = Session.CurrentUser.Email,
                ImageUrl = Session.CurrentUser.ImageUrl ?? "/uploads/user.png"
            };
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var uploadsPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "uploads");
            if (!Directory.Exists(uploadsPath))
            {
                Directory.CreateDirectory(uploadsPath);
            }

            var uniqueFileName = $"{Guid.NewGuid()}_{file.Name}";
            var filePath = Path.Combine(uploadsPath, uniqueFileName);

            using var fs = new FileStream(filePath, FileMode.Create);
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);

            _model.ImageUrl = $"/uploads/{uniqueFileName}";
            StateHasChanged();
        }
    }

    private void SaveChanges()
    {
        using var db = Database.Get();
        string? passwordHash = null;

        if (!string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            passwordHash = BCrypt.Net.BCrypt.HashPassword(_model.NewPassword);
        }

        db.Execute("UPDATE Users SET Name=@Name, Email=@Email, ImageUrl=@ImageUrl"
                 + (passwordHash != null ? ", PasswordHash=@PasswordHash" : "")
                 + " WHERE UserId=@UserId",
            new
            {
                _model.Name,
                _model.Email,
                _model.ImageUrl,
                PasswordHash = passwordHash,
                Session.CurrentUser!.UserId
            });

        _message = "Změny byly úspěšně uloženy.";
    }

    private class ProfileModel
    {
        [Required] public string Name { get; set; } = "";
        [Required] public string Email { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ImageUrl { get; set; } = "/uploads/user.png";
    }
}
