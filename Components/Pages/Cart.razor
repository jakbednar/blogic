@page "/cart"
@using blogic.Models
@inject blogic.Services.CartService CartService
@rendermode InteractiveServer

<PageTitle>Košík</PageTitle>

<header style="background-image: url('https://images.unsplash.com/photo-1559561854-266fba0e52c6'); background-size: cover; background-position: center; height: 200px; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; font-weight: bold;">
    Moje objednávky
</header>

<div style="padding: 30px; max-width: 900px; margin: auto;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <label>Od <input type="date" value="2022-02-03" style="padding: 8px;" /></label>
        <label>Do <input type="date" value="2022-05-09" style="padding: 8px;" /></label>
    </div>

    @if (_cart.Any())
    {
        <table class="cart-table">
            <thead>
            <tr>
                <th>Produkt</th>
                <th>Cena za ks</th>
                <th>Množství</th>
                <th>Akce</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in _cart)
            {
                <tr>
                    <td class="product-info">
                        <img src="@item.ImageUrl" alt="@item.Name" class="cart-img" />
                        <span>@item.Name</span>
                    </td>
                    <td>@item.Price Kč</td>
                    <td>
                        <input type="number" min="0" @bind="quantity" class="quantity-input" />
                    </td>
                    <td>
                        <button class="edit-button">Upravit</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <p class="cart-total">Cena celkem: @_cart.Sum(p => p.Price) Kč</p>

        <button class="export-button">Export</button>

    }
    else
    {
        <p>Košík je prázdný.</p>
    }
</div>

@code {
    private List<Product>? _cart;

    protected override void OnInitialized()
    {
        _cart = CartService.GetCartProducts();
    }
    private int quantity = 0;
}