@page "/cart"
@using System.Data
@using blogic.Models
@using Dapper
@inject blogic.Services.CartService CartService
@inject blogic.Services.ProductService ProductService
@inject blogic.Services.UserSessionService Session
@inject NavigationManager Navigation
@inject IDbConnection Db
@rendermode InteractiveServer

<PageTitle>Košík</PageTitle>

<header style="background-image: url('https://images.unsplash.com/photo-1559561854-266fba0e52c6'); background-size: cover; background-position: center; height: 200px; display: flex; align-items: center; justify-content: center; color: black; font-size: 2rem; font-weight: bold;">
    Moje objednávky
</header>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" style="margin-bottom: 20px; color: green; font-weight: bold;">
        @successMessage
    </div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" style="margin-bottom: 20px; color: red; font-weight: bold;">
        @errorMessage
    </div>
}

@if (!Session.IsLoggedIn)
{
    <AuthAlert />
}
else
{
    <div style="padding: 30px; max-width: 900px; margin: auto;">
        @if (_cart.Any())
        {
            <table class="cart-table">
                <thead>
                <tr>
                    <th>Produkt</th>
                    <th>Cena / ks</th>
                    <th>Celkem</th>
                    <th>Množství</th>
                    <th>Akce</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in _cart)
                {
                    <tr>
                        <td class="product-info">
                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="cart-img" />
                            <span>@item.Product.Name</span>
                        </td>
                        <td>@item.Product.Price Kč</td>
                        <td style="color: green;">@(item.Product.Price * item.Quantity) Kč</td>
                        <td>
                            <button @onclick="() => DecreaseQuantity(item.Product.ProductID)">-</button>
                            @item.Quantity
                            <button @onclick="() => IncreaseQuantity(item.Product.ProductID)">+</button>
                        </td>
                        <td>
                            <button class="action-button delete-button" @onclick="() => RemoveItem(item.Product.ProductID)" title="Odstranit položku">
                                ❌
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <p class="cart-total">Cena celkem: @_cart.Sum(p => p.Product.Price * p.Quantity) Kč</p>

            <button class="export-button" @onclick="PlaceOrder">Objednat</button>
        }
        else
        {
            <p>Košík je prázdný.</p>
        }
    </div>
}

@code {
    private List<CartItem> _cart = new();
    private string? successMessage = null;
    private string? errorMessage = null;


    protected override void OnInitialized()
    {
        _cart = CartService.GetCartItems();
    }

    private void IncreaseQuantity(int productId)
    {
        CartService.IncreaseQuantity(productId);
        _cart = CartService.GetCartItems();
    }

    private void DecreaseQuantity(int productId)
    {
        CartService.DecreaseQuantity(productId);
        _cart = CartService.GetCartItems();
    }

    private void RemoveItem(int productId)
    {
        CartService.RemoveProduct(productId);
        _cart = CartService.GetCartItems();
    }
    
    private async Task PlaceOrder()
    {
        var user = Session.CurrentUser;
        int totalPrice = _cart.Sum(p => p.Product.Price * p.Quantity);

        if (user is null)
        {
            errorMessage = "❌ Přihlášení selhalo.";
            StateHasChanged();
            await Task.Delay(5000);
            errorMessage = null;
            StateHasChanged();
            return;
        }

        if (user.Credit < totalPrice)
        {
            errorMessage = $"❌ Nedostatečný kredit. Chybí ti {totalPrice - user.Credit} Kč.";
            StateHasChanged();
            await Task.Delay(5000);
            errorMessage = null;
            StateHasChanged();
            return;
        }
        
        var orderId = Db.ExecuteScalar<int>(
            "INSERT INTO OrderGroups (UserId) VALUES (@UserId); SELECT last_insert_rowid();",
            new { UserId = user.UserId }
        );

        foreach (var item in _cart)
        {
            await ProductService.DecreaseStockAsync(item.Product.ProductID, item.Quantity);

            Db.Execute(
                "INSERT INTO OrderItems (OrderId, ProductId, Quantity) VALUES (@OrderId, @ProductId, @Quantity)",
                new
                {
                    OrderId = orderId,
                    ProductId = item.Product.ProductID,
                    Quantity = item.Quantity
                });
        }

        Db.Execute("UPDATE Users SET Credit = Credit - @Amount WHERE UserId = @UserId", new
        {
            Amount = totalPrice,
            UserId = user.UserId
        });

        Session.CurrentUser!.Credit -= totalPrice;

        CartService.ClearCart();
        _cart = new();
        successMessage = "✅ Objednávka byla úspěšně odeslána.";

        StateHasChanged();
        await Task.Delay(5000);
        successMessage = null;
        StateHasChanged();
    }
}
