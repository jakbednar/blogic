@page "/cart"
@using blogic.Models
@inject blogic.Services.CartService CartService
@rendermode InteractiveServer

<PageTitle>Košík</PageTitle>

<header style="background-image: url('https://images.unsplash.com/photo-1559561854-266fba0e52c6'); background-size: cover; background-position: center; height: 200px; display: flex; align-items: center; justify-content: center; color: black; font-size: 2rem; font-weight: bold;">
    Moje objednávky
</header>

<div style="padding: 30px; max-width: 900px; margin: auto;">
    @if (_cart.Any())
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Produkt</th>
                    <th>Cena / ks</th>
                    <th>Celkem</th>
                    <th>Množství</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _cart)
                {
                    <tr>
                        <td class="product-info">
                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="cart-img" />
                            <span>@item.Product.Name</span>
                        </td>
                        <td>@item.Product.Price Kč</td>
                        <td style="color: green;">@(item.Product.Price * item.Quantity) Kč</td>
                        <td>
                            <input type="number" min="1" @bind="item.Quantity" class="quantity-input" />
                        </td>
                        <td>
                            <button class="action-button delete-button" @onclick="() => RemoveItem(item.CartItemId)" title="Odstranit položku">
                                ❌
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="cart-total">Cena celkem: @_cart.Sum(p => p.Product.Price * p.Quantity) Kč</p>

        <button class="export-button">Objednat</button>
    }
    else
    {
        <p>Košík je prázdný.</p>
    }
</div>

@code {
    private List<CartItem> _cart = new();

    protected override void OnInitialized()
    {
        _cart = CartService.GetCartItems();
    }

    private void RemoveItem(int cartItemId)
    {
        CartService.RemoveFromCart(cartItemId);
        _cart = CartService.GetCartItems();
    }
}